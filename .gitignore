# Terraform state files - contain sensitive data, never commit these
terraform.tfstate
terraform.tfstate.*
*.tfstate
*.tfstate.backup

# Terraform working directory
.terraform/
.terraform.tfstate.lock.info

# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json
!example.tfvars

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# SSH keys (if any)
*.pem
*.key

# OS files
.DS_Store
Thumbs.db
